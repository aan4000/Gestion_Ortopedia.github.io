# Copia este archivo como .env y pon tus datos.
# .env NO se sube a Git (esta en .gitignore).

# Backend de datos: postgres | mysql | sqlite
DB_BACKEND=postgres

# Opcion A (nube): una sola cadena de conexion (Northflank la entrega asi).
# Si la defines, tienes prioridad sobre las variables PGHOST/PGPORT/...
# DATABASE_URL=postgres://usuario:clave@host:puerto/base?sslmode=require

# Conexion PostgreSQL
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=medhistorical
# SSL obligatorio en la nube (Northflank, Render, etc.)
PGSSL=true

# ------------------------------------------------------------
# Felicitaciones de cumpleaños por EmailJS
# ------------------------------------------------------------
# Clave privada de EmailJS (Account > General > API Keys > Private Key).
# Sin ella el envío automático queda desactivado.
EMAILJS_PRIVATE_KEY=
# Clave pública de EmailJS (por defecto la del proyecto).
# EMAILJS_PUBLIC_KEY=cbWPSb0bNn1FcBZ7t
# Servicio y plantilla de EmailJS (valores por defecto del proyecto).
# EMAILJS_SERVICE_ID=default_service
# EMAILJS_TEMPLATE_ID=template_33jcool
# Correo remitente (reply_to) y nombre visible del remitente.
MAIL_FROM=
MAIL_FROM_NAME=Consultorio de Ortopedia
# Texto del saludo. Usa {nombre} para insertar el nombre del paciente.
# MAIL_SALUDO=Hola {nombre}, en este día tan especial el equipo del consultorio te desea un muy feliz cumpleaños.
# Cada cuántas horas se revisa si hay cumpleaños (por defecto 12).
# CUMPLE_INTERVALO_HORAS=12
